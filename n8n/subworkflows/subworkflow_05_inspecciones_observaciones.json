    {
      "parameters": {
        "jsCode": "const inspecciones = $('Obtener Inspecciones').all().map(i => i.json);\nconst funcionarios = $('Obtener Funcionarios').all().map(i => i.json);\nconst declaraciones = $('Obtener Declaraciones').all().map(i => i.json);\n\nconst funcMap = new Map(funcionarios.map(f => [f.id_funcionario, f]));\nconst decMap = new Map(declaraciones.map(d => [d.id_declaracion, d.numero_dua]));\n\nconst validas = [];\nfor (const insp of inspecciones) {\n  const obs = (insp.observaciones || '').trim();\n  if (!obs) continue;\n  const f = funcMap.get(insp.id_funcionario) || {};\n  validas.push({\n    numero_acta: insp.numero_acta,\n    numero_dua: decMap.get(insp.id_declaracion) || 'Desconocido',\n    fecha_inspeccion: insp.fecha_inspeccion,\n    tipo_inspeccion: insp.tipo_inspeccion,\n    resultado: insp.resultado,\n    funcionario_responsable: f.nombre_completo || 'Desconocido',\n    puesto_cargo: f.puesto_cargo || 'N/A',\n    area_adscripcion: f.area_adscripcion || 'N/A',\n    observaciones: obs\n  });\n}\n\nvalidas.sort((a, b) => b.fecha_inspeccion.localeCompare(a.fecha_inspeccion));\n\nreturn [{\n  json: {\n    estado: 'exitoso',\n    herramienta: 'consultar_inspecciones_con_observaciones',\n    total_registros: validas.length,\n    es_parcial: false,\n    datos: validas\n  }\n}];"
      },
